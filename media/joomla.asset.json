{
    "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
    "name": "com_collector",
    "version": "0.9.9",
    "description": "Collector Web Assets",
    "license": "GPL-2.0-or-later",
    "assets": [
        {
            "name": "com_collector.theme",
            "type": "style",
            "uri": "com_collector/theme.css",
            "version": "0.9.9"
        },
        {
            "name": "com_collector.versionscompare",
            "type": "style",
            "uri": "com_collector/versionscompare.css",
            "version": "0.9.9"
        },
        {
            "name": "com_collector.version-dialog",
            "type": "script",
            "uri": "com_collector/version-dialog.js",
            "version": "0.9.9",
            "attributes": {
                "defer": true
            }
        },
        {
            "name": "com_collector.ordered-fields",
            "type": "script",
            "uri": "com_collector/ordered-fields.js",
            "version": "0.9.9",
            "dependencies": ["core"],
            "attributes": {
                "defer": true
            }
        }
    ]
}