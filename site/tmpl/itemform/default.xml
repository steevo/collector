<?xml version="1.0" encoding="utf-8"?>
<metadata>
	<layout title="COM_COLLECTOR_ITEMFORM_VIEW_DEFAULT_TITLE">
		<message>
			<![CDATA[COM_COLLECTOR_ITEMFORM_VIEW_DEFAULT_TITLE_DESC]]>
		</message>
	</layout>

	<!-- Collection dans laquelle l'objet est proposé -->
	<fields name="request">
		<fieldset name="request"
			addfieldprefix="Steevo\Component\Collector\Administrator\Field">
			<field
				name="collection"
				type="modal_collection"
				label="COM_COLLECTOR_CHOOSE_COLLECTION_LABEL"
				extension="com_collector"
				required="true"
				select="true"
			/>
		</fieldset>
	</fields>

	<!-- Traitement de la proposition (à défaut, les options du composant) -->
	<fields name="params">
		<fieldset name="submit" label="COM_COLLECTOR_SUBMIT">
			<field
				name="auto_publish"
				type="list"
				useglobal="true"
				label="COM_COLLECTOR_AUTO_PUBLISH"
				description="COM_COLLECTOR_AUTO_PUBLISH_DESC">
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field
				name="show_publishfields"
				type="list"
				useglobal="true"
				label="COM_COLLECTOR_SHOW_PUBLISHFIELDS"
				description="COM_COLLECTOR_SHOW_PUBLISHFIELDS_DESC">
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field
				name="show_metafields"
				type="list"
				useglobal="true"
				label="COM_COLLECTOR_SHOW_METAFIELDS"
				description="COM_COLLECTOR_SHOW_METAFIELDS_DESC">
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
		</fieldset>
	</fields>
</metadata>
