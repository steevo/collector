<?xml version="1.0" encoding="utf-8"?>
<form>
	<config>
		<inlinehelp button="show"/>
	</config>
	<fieldset>
		<field
			name="id"
			type="text"
			label="JGLOBAL_FIELD_ID_LABEL"
			class="readonly"
			description ="JGLOBAL_FIELD_ID_DESC"
			default="0" 
			readonly="true"
		/>

		<field
			name="name"
			type="text"
			label="COM_COLLECTOR_DEFINED_NAME_LABEL"
			description="COM_COLLECTOR_DEFINED_NAME_LABEL_DESC"
			class="inputbox input-xxlarge input-large-text"
			size="40"
			required="true"
		/>
		
		<field
			name="alias"
			type="text"
			label="JFIELD_ALIAS_LABEL"
			description="JFIELD_ALIAS_DESC"
			hint="JFIELD_ALIAS_PLACEHOLDER"
			class="inputbox"
			size="45"
		/>
		
		<field
			name="created"
			type="calendar"
			label="COM_COLLECTOR_FIELD_CREATED_LABEL"
			description="COM_COLLECTOR_FIELD_CREATED_DESC"
			translateformat="true"
			showtime="true"
			filter="user_utc"
		/>

		<field
			name="created_by"
			type="user"
			label="COM_COLLECTOR_FIELD_CREATED_BY_LABEL"
			description="COM_COLLECTOR_FIELD_CREATED_BY_DESC"
		/>

		<field
			name="created_by_alias"
			type="text"
			label="COM_COLLECTOR_FIELD_CREATED_BY_ALIAS_LABEL"
			description="COM_COLLECTOR_FIELD_CREATED_BY_ALIAS_DESC"
		/>

		<field
			name="modified"
			type="calendar"
			label="JGLOBAL_FIELD_MODIFIED_LABEL"
			class="form-control"
			translateformat="true"
			showtime="true"
			readonly="true"
			filter="user_utc"
		/>

		<field
			name="modified_by"
			type="user"
			label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
			class="readonly"
			readonly="true"
			filter="unset"
			validate="UserId"
		/>

		<field
			name="checked_out"
			type="hidden"
			filter="unset"
		/>

		<field
			name="checked_out_time"
			type="hidden"
			filter="unset"
		/>

		<field
			name="access"
			type="accesslevel"
			label="JFIELD_ACCESS_LABEL"
			filter="UINT"
			validate="options"
		/>
		
		<field
			name="width"
			type="text"
			label="COM_COLLECTOR_FIELD_WIDTH_LABEL"
			description="COM_COLLECTOR_FIELD_WIDTH_DESC"
			class="inputbox"
			size="45"
		/>
		
		<field
			name="height"
			type="text"
			label="COM_COLLECTOR_FIELD_HEIGHT_LABEL"
			description="COM_COLLECTOR_FIELD_HEIGHT_DESC"
			class="inputbox"
			size="45"
		/>
	</fieldset>
</form>