<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Steevo\Component\Collector\Administrator\Field">
	<fieldset>
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" default="0" readonly="true" class="readonly" />

		<field
			name="name"
			type="text"
			label="COM_COLLECTOR_TEMPLATE_NAME_LABEL"
			required="true"
			maxlength="255"
		/>

		<field name="alias" type="hidden" />

		<field
			name="collection"
			type="collections"
			label="COM_COLLECTOR_FIELD_COLLECTION_LABEL"
			required="true"
		/>

		<field
			name="client"
			type="radio"
			label="COM_COLLECTOR_TEMPLATE_CLIENT_LABEL"
			description="COM_COLLECTOR_TEMPLATE_CLIENT_DESC"
			layout="joomla.form.field.radio.switcher"
			default="1"
			>
			<option value="0">COM_COLLECTOR_TEMPLATE_CLIENT_ITEM</option>
			<option value="1">COM_COLLECTOR_TEMPLATE_CLIENT_LIST</option>
		</field>

		<field
			name="state"
			type="list"
			label="JSTATUS"
			class="form-select-color-state"
			default="1"
			filter="intval"
			>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>

		<field
			name="content"
			type="editor"
			label="COM_COLLECTOR_TEMPLATE_CONTENT_LABEL"
			description="COM_COLLECTOR_TEMPLATE_CONTENT_DESC"
			editor="codemirror|none"
			syntax="html"
			buttons="false"
			height="420"
			filter="raw"
		/>

		<field
			name="css"
			type="editor"
			label="COM_COLLECTOR_TEMPLATE_CSS_LABEL"
			description="COM_COLLECTOR_TEMPLATE_CSS_DESC"
			editor="codemirror|none"
			syntax="css"
			buttons="false"
			height="250"
			filter="raw"
		/>
	</fieldset>
</form>
