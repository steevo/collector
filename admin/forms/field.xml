<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Steevo\Component\Collector\Administrator\Field">
	<config>
		<inlinehelp button="show"/>
	</config>
	<fieldset>
		<field
			name="id" 
			type="text"
			label="JGLOBAL_FIELD_ID_LABEL"
			description ="JGLOBAL_FIELD_ID_DESC"
			class="readonly"
			default="0" 
			readonly="true"
		/>

		<field
			name="asset_id"
			type="hidden"
			filter="unset"
		/>

		<field
			name="collection" 
			type="collection"
			label="COM_COLLECTOR_FIELD_COLLECTION_LABEL"
			description ="COM_COLLECTOR_FIELD_COLLECTION_DESC"
			default="0" 
			readonly="true"
			onchange=""
		/>
			
		<field
			name="field"
			type="text"
			label="COM_COLLECTOR_FIELD_FIELD_LABEL"
			description="COM_COLLECTOR_FIELD_FIELD_DESC"
			size="60"
			class="inputbox input-xxlarge input-large-text"
			required="true"
		/>
		
		<field
			name="tablecolumn"
			type="text"
			label="COM_COLLECTOR_FIELD_TABLECOLUMN_LABEL"
			description="COM_COLLECTOR_FIELD_TABLECOLUMN_DESC"
			hint="JFIELD_ALIAS_PLACEHOLDER"
		/>
		
		<field
			name="description"
			type="textarea"
			label="COM_COLLECTOR_FIELD_DESCRIPTION_LABEL"
			description="COM_COLLECTOR_FIELD_DESCRIPTION_DESC"
			class="inputbox"
			cols="50"
			rows="4"
		/>

		<field
			name="next_sorted_field"
			type="nextsortedfield"
			label="COM_COLLECTOR_FIELD_NEXT_SORTED_FIELD_LABEL"
			description="COM_COLLECTOR_FIELD_NEXT_SORTED_FIELD_DESC"
			default="0"
		/>
		
		<field
			name="column_width"
			type="text"
			label="COM_COLLECTOR_FIELD_COLUMN_WIDTH_LABEL"
			description="COM_COLLECTOR_FIELD_COLUMN_WIDTH_DESC"
			size="60"
			class="inputbox"
		/>
		
		<field
			name="state"
			type="list"
			label="JSTATUS"
			class="form-select-color-state"
			description="JFIELD_PUBLISHED_DESC"
			default="1"
			filter="integer"
			validate="options"
		>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="-2">JTRASHED</option>
		</field>
		
		<field
			name="type"
			type="type"
			label="COM_COLLECTOR_FIELD_TYPE_LABEL"
			description="COM_COLLECTOR_FIELD_TYPE_DESC"
			required="true"
			class="inputbox validate-typeverify"
			onchange="displayAttribs()"
			>
			<option value="">COM_COLLECTOR_SELECT_FIELD_TYPE</option>
		</field>
		
		<field
			name="ordering"
			type="ordering"
			label="JFIELD_ORDERING_LABEL"
			description="JFIELD_ORDERING_DESC"
			class="inputbox"
			table="#__collector_fields"
		/>

		<field
			name="created"
			type="calendar"
			label="COM_COLLECTOR_FIELD_CREATED_LABEL"
			description="COM_COLLECTOR_FIELD_CREATED_DESC"
			translateformat="true"
			showtime="true"
			filter="user_utc"
		/>

		<field
			name="created_by"
			type="user"
			label="COM_COLLECTOR_FIELD_CREATED_BY_LABEL"
			description="COM_COLLECTOR_FIELD_CREATED_BY_DESC"
		/>

		<field
			name="created_by_alias"
			type="text"
			label="COM_COLLECTOR_FIELD_CREATED_BY_ALIAS_LABEL"
			description="COM_COLLECTOR_FIELD_CREATED_BY_ALIAS_DESC"
		/>

		<field
			name="modified"
			type="calendar"
			label="JGLOBAL_FIELD_MODIFIED_LABEL"
			class="form-control"
			translateformat="true"
			showtime="true"
			readonly="true"
			filter="user_utc"
		/>

		<field
			name="modified_by"
			type="user"
			label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
			class="readonly"
			readonly="true"
			filter="unset"
			validate="UserId"
		/>

		<field
			name="publish_up"
			type="calendar"
			label="COM_COLLECTOR_FIELD_PUBLISH_UP_LABEL"
			description="COM_COLLECTOR_FIELD_PUBLISH_UP_DESC"
			translateformat="true"
			showtime="true"
			filter="user_utc"
		/>

		<field
			name="publish_down"
			type="calendar"
			label="COM_COLLECTOR_FIELD_PUBLISH_DOWN_LABEL"
			description="COM_COLLECTOR_FIELD_PUBLISH_DOWN_DESC"
			translateformat="true"
			showtime="true"
			filter="user_utc"
		/>
		
		<field
			name="checked_out"
			type="hidden"
			filter="unset"
		/>

		<field
			name="checked_out_time"
			type="hidden"
			filter="unset"
		/>

		<field
			name="required"
			type="radio"
			class="btn-group btn-group-yesno"
			label="COM_COLLECTOR_FIELD_REQUIRED_LABEL"
			description="COM_COLLECTOR_FIELD_REQUIRED_DESC"
			default="0"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		
		<field
			name="access"
			type="accesslevel"
			label="JFIELD_ACCESS_LABEL"
			filter="UINT"
			validate="options"
		/>

		<field 
			name="home"
			type="radio"
			class="btn-group btn-group-yesno"
			label="COM_COLLECTOR_FIELD_HOME_LABEL"
			description="COM_COLLECTOR_FIELD_HOME_DESC"
			default="0"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		
		<field
			name="unik"
			type="yesnoimpossible"
			label="COM_COLLECTOR_FIELD_UNIK_LABEL"
			description="COM_COLLECTOR_FIELD_UNIK_DESC"
			default="0"
			layout="joomla.form.field.radio.switcher"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		
		<field
			name="edit"
			type="radio"
			label="COM_COLLECTOR_FIELD_EDIT_LABEL"
			description="COM_COLLECTOR_FIELD_EDIT_DESC"
			default="1"
			layout="joomla.form.field.radio.switcher"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field
			name="listing"
			type="radio"
			label="COM_COLLECTOR_FIELD_LISTING_LABEL"
			description="COM_COLLECTOR_FIELD_LISTING_DESC"
			default="1"
			layout="joomla.form.field.radio.switcher"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field
			name="filter"
			type="yesnoimpossible"
			label="COM_COLLECTOR_FIELD_FILTER_LABEL"
			description="COM_COLLECTOR_FIELD_FILTER_DESC"
			default="0"
			layout="joomla.form.field.radio.switcher"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field
			name="sort"
			type="yesnoimpossible"
			label="COM_COLLECTOR_FIELD_SORT_LABEL"
			description="COM_COLLECTOR_FIELD_SORT_DESC"
			default="0"
			layout="joomla.form.field.radio.switcher"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		
		<field
			name="rules"
			type="rules"
			label="JFIELD_RULES_LABEL"
			translate_label="false"
			filter="rules"
			component="com_collector"
			section="field"
			validate="rules"
		/>

	</fieldset>
	
	<fields name="attribs" />
</form>