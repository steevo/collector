<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="publishing">

        <field
            name="state"
            type="list"
            label="JSTATUS"
            class="form-select-color-state"
            default="1"
            filter="integer"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
        </field>

        <field
            name="access"
            type="accesslevel"
            label="JFIELD_ACCESS_LABEL"
            default="1"
            filter="UINT"
        />

        <field
            name="publish_up"
            type="calendar"
            label="COM_COLLECTOR_FIELD_PUBLISH_UP_LABEL"
            description="COM_COLLECTOR_FIELD_PUBLISH_UP_DESC"
            translateformat="true"
            showtime="true"
            filter="user_utc"
        />

        <field
            name="publish_down"
            type="calendar"
            label="COM_COLLECTOR_FIELD_PUBLISH_DOWN_LABEL"
            description="COM_COLLECTOR_FIELD_PUBLISH_DOWN_DESC"
            translateformat="true"
            showtime="true"
            filter="user_utc"
        />

    </fieldset>
</form>