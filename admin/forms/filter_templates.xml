<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Steevo\Component\Collector\Administrator\Field">
	<field
		name="collection"
		type="collections"
		label="COM_COLLECTOR_FILTER_COLLECTION"
		filtermode="selector"
		layout="joomla.form.field.list-fancy-select"
		class="js-select-submit-on-change"
	/>
	<fields name="filter">
		<field
			name="search"
			type="text"
			label="COM_COLLECTOR_FILTER_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>
		<field
			name="client"
			type="list"
			label="COM_COLLECTOR_TEMPLATE_CLIENT_LABEL"
			onchange="this.form.submit();"
			>
			<option value="">COM_COLLECTOR_TEMPLATE_SELECT_CLIENT</option>
			<option value="1">COM_COLLECTOR_TEMPLATE_CLIENT_LIST</option>
			<option value="0">COM_COLLECTOR_TEMPLATE_CLIENT_ITEM</option>
		</field>
	</fields>
	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			onchange="this.form.submit();"
			default="t.name ASC"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="t.name ASC">JGLOBAL_TITLE_ASC</option>
			<option value="t.name DESC">JGLOBAL_TITLE_DESC</option>
			<option value="t.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="t.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>
		<field
			name="limit"
			type="limitbox"
			default="25"
			label="JGLOBAL_LIST_LIMIT"
			onchange="this.form.submit();"
		/>
	</fields>
</form>
