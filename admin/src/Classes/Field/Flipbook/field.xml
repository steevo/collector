<?xml version="1.0" encoding="utf-8"?>
<install type="collector" version="0.9.3">
	<name>flipbook</name>
	<creationDate>2026</creationDate>
	<author>Philippe Ousset</author>
	<authorEmail>steevo@steevo.fr</authorEmail>
	<authorUrl>www.steevo.fr</authorUrl>
	<copyright>Copyright (C) 2010-2026 Philippe Ousset. All rights reserved.</copyright>
	<license>http://www.gnu.org/licenses/gpl-2.0.html GNU/GPL</license>
	<version>0.9.3</version>
	<description>Field type Flipbook (online reader) for Collector</description>
	<files>
		<filename>CollectorFieldFlipbook.php</filename>
		<filename>field.xml</filename>
	</files>
	<config>
		<fieldset name="general">
			<field name="unikable" type="text" default="0" label="COM_COLLECTOR_UNIKABLE_LABEL" description="COM_COLLECTOR_UNIKABLE_DESC" />
			<field name="sortable" type="text" default="0" label="COM_COLLECTOR_SORTABLE_LABEL" description="COM_COLLECTOR_SORTABLE_DESC" />
			<field name="searchable" type="text" default="0" label="COM_COLLECTOR_SEARCHABLE_LABEL" description="COM_COLLECTOR_SEARCHABLE_DESC" />
			<field name="filterable" type="text" default="0" label="COM_COLLECTOR_FILTERABLE_LABEL" description="COM_COLLECTOR_FILTERABLE_DESC" />
			<field name="intitle" type="text" default="0" label="COM_COLLECTOR_INTITLE_LABEL" description="COM_COLLECTOR_INTITLE_DESC" />
		</fieldset>

		<fields name="attribs">
			<field
				name="listing_display"
				type="list"
				default="link"
				label="COM_COLLECTOR_FLIPBOOK_LISTING_DISPLAY_LABEL"
				description="COM_COLLECTOR_FLIPBOOK_DISPLAY_DESC">
					<option value="link">COM_COLLECTOR_FLIPBOOK_DISPLAY_LINK</option>
					<option value="button">COM_COLLECTOR_FLIPBOOK_DISPLAY_BUTTON</option>
					<option value="hide">COM_COLLECTOR_FLIPBOOK_DISPLAY_HIDE</option>
			</field>
			<field
				name="detail_display"
				type="list"
				default="button"
				label="COM_COLLECTOR_FLIPBOOK_DETAIL_DISPLAY_LABEL"
				description="COM_COLLECTOR_FLIPBOOK_DISPLAY_DESC">
					<option value="link">COM_COLLECTOR_FLIPBOOK_DISPLAY_LINK</option>
					<option value="button">COM_COLLECTOR_FLIPBOOK_DISPLAY_BUTTON</option>
					<option value="hide">COM_COLLECTOR_FLIPBOOK_DISPLAY_HIDE</option>
			</field>
			<field
				name="button_text"
				type="text"
				default=""
				label="COM_COLLECTOR_FLIPBOOK_BUTTON_TEXT_LABEL"
				description="COM_COLLECTOR_FLIPBOOK_BUTTON_TEXT_DESC"
			/>
			<field
				name="show_pages"
				type="radio"
				layout="joomla.form.field.radio.switcher"
				default="1"
				label="COM_COLLECTOR_FLIPBOOK_SHOW_PAGES_LABEL">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
			</field>
			<field
				name="restricted"
				type="list"
				default="show"
				label="COM_COLLECTOR_FLIPBOOK_RESTRICTED_LABEL"
				description="COM_COLLECTOR_FLIPBOOK_RESTRICTED_DESC">
					<option value="show">COM_COLLECTOR_FLIPBOOK_RESTRICTED_SHOW</option>
					<option value="hide">COM_COLLECTOR_FLIPBOOK_RESTRICTED_HIDE</option>
			</field>
		</fields>
	</config>
</install>
